{
  "name": "vscode-claude-usage-tracker",
  "displayName": "Claude Usage Tracker",
  "description": "Shows Claude Code token usage and API-equivalent cost in the status bar: rolling 5h and 7d windows, last prompt, per-model and per-effort breakdown",
  "version": "0.2.0",
  "publisher": "exystorg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/exystorg/vscode-claude-usage-tracker.git"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-usage.showDetail",
        "title": "Claude Usage: Show Detail"
      },
      {
        "command": "claude-usage.refresh",
        "title": "Claude Usage: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "statusBar/item/context": [
        {
          "command": "claude-usage.refresh",
          "when": "statusBarItemId == 'claude-usage.statusbar'"
        },
        {
          "command": "claude-usage.showDetail",
          "when": "statusBarItemId == 'claude-usage.statusbar'"
        }
      ]
    },
    "configuration": {
      "title": "Claude Usage Tracker",
      "properties": {
        "claude-usage.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often to rescan transcripts (seconds). Only changed files are re-parsed."
        },
        "claude-usage.pricing": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-model prices in USD per million tokens, keyed by model-id prefix (longest prefix wins). Overrides/extends the built-in table, e.g. `{ \"claude-sonnet-5-5\": { \"input\": 3, \"output\": 15 } }`. Cache writes are charged at 1.25x (5m TTL) / 2x (1h TTL) input, cache reads at 0.1x input. These are API list-price equivalents, not subscription billing.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 }
            },
            "required": ["input", "output"]
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
